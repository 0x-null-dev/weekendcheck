# Supabase: use Connect > Session pooler on IPv4 networks.
# For local development, use compose.dev.yaml and the URL in README.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Required in production. Use your exact HTTPS origin when deployed.
APP_URL="http://localhost:3000"
# Used only by db:migrate to initialize login, and admin:set-password to rotate it.
# Choose your own password (12–256 characters); never commit this value.
ADMIN_PASSWORD=""

# Persistent screenshots/video. Supabase bucket must be PRIVATE.
MEDIA_STORAGE="supabase"
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="weekendcheck-media"
# For development or a persistent Docker volume, use MEDIA_STORAGE="local".
# If required, set DATABASE_SSL_CA to your Supabase root certificate PEM.

# Optional: enables fetching recent replies to an X call post.
X_BEARER_TOKEN=""

# Optional: user-context X credentials with Read and Write permission.
# Posting remains off until explicitly enabled AND npm run scheduler is running.
X_API_KEY=""
X_API_SECRET=""
X_ACCESS_TOKEN=""
X_ACCESS_TOKEN_SECRET=""
X_POSTING_ENABLED="false"

# Optional absolute path for local media (editorial data always uses Postgres).
# Defaults to .weekendcheck in the project directory.
# WEEKENDCHECK_DATA_DIR="/path/to/persistent/weekendcheck"
